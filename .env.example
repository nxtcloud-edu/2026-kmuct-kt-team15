# Copy to .env and fill in. .env is never committed (SPEC section 4).
DB_PATH=data/kmu.db
# "Today" for every date calculation. 2026-03-16 is a Monday.
DEMO_TODAY=2026-03-16
# llm-x gateway. Server only, never sent to the browser.
LLM_BASE_URL=
LLM_API_KEY=
# Qwen3 thinking mode: 1 = on. Chat keeps it off.
LLM_THINKING=0
# HTTP Basic password for /admin (tier 2). Empty = nobody gets in.
ADMIN_PASSWORD=
