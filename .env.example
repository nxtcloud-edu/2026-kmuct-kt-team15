# Copy to .env and fill in. .env is never committed (SPEC section 4).
DB_PATH=data/kmu.db
# "Today" for every date calculation. 2026-03-16 is a Monday.
DEMO_TODAY=2026-03-16
# llm-x gateway. Server only, never sent to the browser.
LLM_BASE_URL=
LLM_API_KEY=
# Qwen3 thinking mode: 1 = on. Chat keeps it off.
LLM_THINKING=0
# HTTP Basic password for /admin (tier 2). Empty = nobody gets in.
ADMIN_PASSWORD=
# Which model answers the chat tab (SPEC 8.4). "claude" = the contest gateway below (chosen 9/20);
# unset or anything else = llm-x above.
LLM_PROVIDER=claude
# Contest gateway key (sk-...) and Claude alias. CLAUDE_BASE_URL defaults to https://52.79.201.46/v1.
CLAUDE_API_KEY=
CLAUDE_MODEL=bedrock-claude-sonnet-5
